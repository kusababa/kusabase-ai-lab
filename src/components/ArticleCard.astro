---
import type { ArticleEntry } from '../utils/articles'
import { getArticleUrl } from '../utils/articles'
import { calculateReadingTime } from '../utils/readingTime'
import CategoryBadge from './CategoryBadge.astro'

interface Props {
  article: ArticleEntry
}

const { article } = Astro.props
const url = getArticleUrl(article)
const readingTime = calculateReadingTime(article.body)
const formattedDate = article.data.publishDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-greige-200 bg-ivory-50 transition-shadow hover:shadow-md">
  <a href={url} class="block aspect-[16/9] overflow-hidden bg-ivory-300">
    {article.data.heroImage ? (
      <img src={article.data.heroImage} alt={article.data.title} class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-greige-500">
        <span class="text-sm">KusaBase AI Lab</span>
      </div>
    )}
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <CategoryBadge category={article.data.category} />
    <a href={url}>
      <h3 class="text-lg font-medium leading-snug text-charcoal-900 group-hover:underline">{article.data.title}</h3>
    </a>
    <p class="line-clamp-2 flex-1 text-sm text-charcoal-500">{article.data.description}</p>
    <div class="flex items-center gap-3 text-xs text-charcoal-300">
      <time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">・</span>
      <span>{readingTime}分で読了</span>
    </div>
  </div>
</article>
