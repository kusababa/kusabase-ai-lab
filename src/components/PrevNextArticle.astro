---
import type { ArticleEntry } from '../utils/articles'
import { getArticleUrl } from '../utils/articles'

interface Props {
  prev: ArticleEntry | null
  next: ArticleEntry | null
}

const { prev, next } = Astro.props
---

{(prev || next) && (
  <nav aria-label="前後の記事" class="mt-12 grid gap-4 border-t border-greige-200 pt-8 sm:grid-cols-2">
    <div>
      {prev && (
        <a href={getArticleUrl(prev)} class="block rounded-xl border border-greige-200 p-4 hover:border-charcoal-500">
          <p class="mb-1 text-xs text-charcoal-300">前の記事</p>
          <p class="text-sm font-medium text-charcoal-900">{prev.data.title}</p>
        </a>
      )}
    </div>
    <div>
      {next && (
        <a href={getArticleUrl(next)} class="block rounded-xl border border-greige-200 p-4 text-right hover:border-charcoal-500">
          <p class="mb-1 text-xs text-charcoal-300">次の記事</p>
          <p class="text-sm font-medium text-charcoal-900">{next.data.title}</p>
        </a>
      )}
    </div>
  </nav>
)}
