---
interface Props {
  tags: string[]
}

const { tags } = Astro.props
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${encodeURIComponent(tag)}/`}
          class="rounded-full border border-greige-300 px-3 py-1 text-xs text-charcoal-500 hover:border-charcoal-500 hover:text-charcoal-900"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
