---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ArticleCard from '../../../components/ArticleCard.astro'
import { getAllTags, getArticlesByTag, type ArticleEntry } from '../../../utils/articles'

export async function getStaticPaths() {
  const tags = await getAllTags()
  return await Promise.all(
    tags.map(async (tag) => ({
      params: { tag },
      props: { articles: await getArticlesByTag(tag) },
    }))
  )
}

interface Props {
  articles: ArticleEntry[]
}

const { articles } = Astro.props as Props
const tag = Astro.params.tag as string
---

<BaseLayout
  title={`#${tag} の記事一覧`}
  description={`「${tag}」タグが付いた記事の一覧です。`}
  breadcrumbs={[{ name: `#${tag}`, url: `/tags/${encodeURIComponent(tag)}/` }]}
>
  <section class="container-page section-padding">
    <header class="mb-10">
      <h1 class="text-3xl font-medium text-charcoal-900">#{tag}</h1>
      <p class="mt-2 text-charcoal-500">{articles.length}件の記事があります。</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
