---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="検索"
  description="KusaBase AI Labの記事を検索します。"
  breadcrumbs={[{ name: '検索', url: '/search/' }]}
>
  <section class="container-page section-padding max-w-3xl">
    <h1 class="mb-8 text-3xl font-medium text-charcoal-900">記事を検索</h1>

    <!--
      Pagefindは `npm run build` 実行時に /pagefind/ 配下へ検索インデックスとUIスクリプトを生成する。
      そのため `astro dev` では動作せず、`npm run build && npm run preview` で確認する必要がある。
    -->
    <div id="search"></div>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
          new PagefindUI({ element: '#search', showSubResults: true, showImages: false })
        }
      })
    </script>
  </section>
</BaseLayout>
