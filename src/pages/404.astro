---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="ページが見つかりません" description="お探しのページが見つかりませんでした。">
  <section class="container-page section-padding text-center">
    <p class="mb-4 text-sm font-medium tracking-widest text-charcoal-500">404</p>
    <h1 class="mb-6 text-3xl font-medium text-charcoal-900">ページが見つかりませんでした</h1>
    <p class="mb-8 text-charcoal-500">URLが変更されたか、削除された可能性があります。</p>
    <a href="/" class="rounded-full bg-charcoal-900 px-6 py-3 text-sm font-medium text-ivory-50 hover:bg-charcoal-700">
      トップページへ戻る
    </a>
  </section>
</BaseLayout>
