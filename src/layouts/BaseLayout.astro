---
import '../styles/global.css'
import SEO from '../components/SEO.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface BreadcrumbItem {
  name: string
  url: string
}

interface Props {
  title: string
  description: string
  ogImage?: string
  pageType?: 'website' | 'article'
  publishDate?: Date
  updatedDate?: Date
  keywords?: string[]
  breadcrumbs?: BreadcrumbItem[]
}

const { title, description, ogImage, pageType, publishDate, updatedDate, keywords, breadcrumbs } = Astro.props
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/AILab_icon.png" />
    <link rel="apple-touch-icon" href="/AILab_icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="KusaBase AI Lab" href="/rss.xml" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7RN9DMWGM8" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7RN9DMWGM8');
    </script>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      pageType={pageType}
      publishDate={publishDate}
      updatedDate={updatedDate}
      keywords={keywords}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
